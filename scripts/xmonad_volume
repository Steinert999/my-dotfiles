#!/usr/bin/env bash

## Copyright (C) 2020-2024 Aditya Shakya <adi1090x@gmail.com>
##
## Script to manage speaker volume on Archcraft.
## Modificado para controlar o sink que está tocando áudio (ex: Bluetooth)

# Icons
iDIR='/usr/share/archcraft/icons/dunst'
notify_cmd='dunstify -u low -h string:x-dunst-stack-tag:obvolume'

# Get active sink (o que está realmente tocando áudio)
get_active_sink() {
	# Procura por sink com streams ativos
	active_sink=$(wpctl status 2>/dev/null | grep -A 1000 "Streams:" | grep "output_FL.*>" | head -1 | sed 's/.*> //' | sed 's/:.*//' | xargs)
	
	if [[ -n "$active_sink" ]]; then
		# Pega o ID do sink pelo nome (apenas da seção Sinks, antes de Sources)
		sink_id=$(wpctl status 2>/dev/null | sed -n '/Sinks:/,/Sources:/p' | grep "$active_sink" | grep "│" | awk '{print $2}' | sed 's/\..*//' | head -1)
		if [[ -n "$sink_id" ]] && [[ "$sink_id" =~ ^[0-9]+$ ]]; then
			echo "$sink_id"
			return
		fi
	fi
	
	# Fallback: sink padrão (marcado com *)
	sink_id=$(wpctl status 2>/dev/null | sed -n '/Sinks:/,/Sources:/p' | grep "\*" | awk '{print $3}' | sed 's/\..*//' | head -1)
	if [[ -n "$sink_id" ]] && [[ "$sink_id" =~ ^[0-9]+$ ]]; then
		echo "$sink_id"
	else
		echo "@DEFAULT_AUDIO_SINK@"
	fi
}

# Get Volume
get_volume() {
	sink=$(get_active_sink)
	info=$(wpctl get-volume "$sink")
	echo $(echo "$info" | awk '{printf "%d", $2 * 100}')
}

# Get icons
get_icon() {
	current="$(get_volume)"
	if [[ "$current" -eq "0" ]]; then
		icon="$iDIR/volume-mute.png"
	elif [[ ("$current" -ge "0") && ("$current" -le "30") ]]; then
		icon="$iDIR/volume-low.png"
	elif [[ ("$current" -ge "30") && ("$current" -le "60") ]]; then
		icon="$iDIR/volume-mid.png"
	elif [[ ("$current" -ge "60") && ("$current" -le "100") ]]; then
		icon="$iDIR/volume-high.png"
	fi
}

# Notify
notify_user() {
	sink=$(get_active_sink)
	sink_name=$(wpctl status | grep "Sinks:" -A 100 | grep "^.*${sink}" | sed 's/^.*[0-9]\.\s//' | sed 's/\[.*$//' | xargs)
	${notify_cmd} -i "$icon" "Volume: $(get_volume)%\n${sink_name}"
}

# Increase Volume
inc_volume() {
	sink=$(get_active_sink)
	muted=$(wpctl get-volume "$sink" | grep -c "MUTED")
	[[ "$muted" -gt 0 ]] && wpctl set-mute "$sink" 0
	wpctl set-volume -l 1.0 "$sink" 5%+ && get_icon && notify_user
}

# Decrease Volume
dec_volume() {
	sink=$(get_active_sink)
	muted=$(wpctl get-volume "$sink" | grep -c "MUTED")
	[[ "$muted" -gt 0 ]] && wpctl set-mute "$sink" 0
	wpctl set-volume "$sink" 5%- && get_icon && notify_user
}

# Toggle Mute — muta o sink ativo e todos os sink-inputs
toggle_mute() {
	sink=$(get_active_sink)
	# Verifica se o sink está mutado
	muted=$(wpctl get-volume "$sink" | grep -c "MUTED")
	if [[ "$muted" -eq 0 ]]; then
		# Muta o sink e todos os sink-inputs
		wpctl set-mute "$sink" 1
		pactl list sink-inputs short | awk '{print $1}' | while read id; do
			pactl set-sink-input-mute "$id" 1
		done
		${notify_cmd} -i "$iDIR/volume-mute.png" "Mute"
	else
		# Desmuta o sink e todos os sink-inputs
		wpctl set-mute "$sink" 0
		pactl list sink-inputs short | awk '{print $1}' | while read id; do
			pactl set-sink-input-mute "$id" 0
		done
		get_icon && ${notify_cmd} -i "$icon" "Unmute"
	fi
}

# Toggle Mic
toggle_mic() {
	muted=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -c "MUTED")
	if [[ "$muted" -eq 0 ]]; then
		wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 1 && ${notify_cmd} -i "$iDIR/microphone-mute.png" "Microphone Switched OFF"
	else
		wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0 && ${notify_cmd} -i "$iDIR/microphone.png" "Microphone Switched ON"
	fi
}

if [[ "$1" == "--get" ]]; then
	get_volume
elif [[ "$1" == "--inc" ]]; then
	inc_volume
elif [[ "$1" == "--dec" ]]; then
	dec_volume
elif [[ "$1" == "--toggle" ]]; then
	toggle_mute
elif [[ "$1" == "--toggle-mic" ]]; then
	toggle_mic
else
	echo $(get_volume)%
fi
